### MCP tool discovery — lists all available tools
# Start the function app locally (func start), then run these requests.
# The MCP endpoint is a webhook — it expects the MCP protocol format.
# For interactive testing, use VS Code with the mcp.json config (easier).
# These .http requests are useful for verifying the server is up and parsing responses.

@baseUrl = http://localhost:7071
@mcpEndpoint = {{baseUrl}}/runtime/webhooks/mcp

### Initialize — required first call to establish the MCP session
POST {{mcpEndpoint}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2024-11-05",
    "capabilities": {},
    "clientInfo": {
      "name": "test-client",
      "version": "1.0.0"
    }
  }
}

###

### List tools — returns all registered MCP tools and their schemas
POST {{mcpEndpoint}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}

###

### List products — returns all SKUs, names, prices, and stock status
POST {{mcpEndpoint}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "list_products",
    "arguments": {}
  }
}

###

### Get product info — look up a specific SKU
POST {{mcpEndpoint}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 4,
  "method": "tools/call",
  "params": {
    "name": "get_product_info",
    "arguments": {
      "sku": "CTL-PRO-X"
    }
  }
}

###

### Get product info — unknown SKU (tests not-found path)
POST {{mcpEndpoint}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 5,
  "method": "tools/call",
  "params": {
    "name": "get_product_info",
    "arguments": {
      "sku": "UNKNOWN-SKU"
    }
  }
}

###

### Save product details (requires Azurite running)
POST {{mcpEndpoint}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 6,
  "method": "tools/call",
  "params": {
    "name": "save_product_details",
    "arguments": {
      "sku": "CTL-PRO-X",
      "details": "The Pro Gaming Controller features a 1000Hz polling rate, Hall effect thumbsticks, and a 40-hour battery life. Compatible with PC and console."
    }
  }
}

###

### Get product details (requires Azurite running)
POST {{mcpEndpoint}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 7,
  "method": "tools/call",
  "params": {
    "name": "get_product_details",
    "arguments": {
      "sku": "CTL-PRO-X"
    }
  }
}

###

### Get product details — SKU with no saved details yet
POST {{mcpEndpoint}}
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 8,
  "method": "tools/call",
  "params": {
    "name": "get_product_details",
    "arguments": {
      "sku": "HEADSET-7X"
    }
  }
}
